# Optional. Uncomment and configure for LLM-assisted open-ended planning.
# LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://openai.generative.engine.capgemini.com/v1
LLM_MODEL=amazon.nova-lite-v1:0
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Local development may leave API_AUTH_REQUIRED=false and omit API_KEY.
# Production must set API_KEY or API_KEYS_JSON and keep API_AUTH_REQUIRED=true.
ENVIRONMENT=development
API_AUTH_REQUIRED=false
# API_KEY=replace_with_a_long_random_secret
# API_KEYS_JSON=[{"key":"replace_with_a_long_random_secret","principal_id":"analyst-1","role":"analyst","data_root":"analyst-1"}]
AGENT_STATE_DB=state/agent_state.sqlite3
# API sources are restricted to this directory (default: ./data).
# DATA_ROOT=data